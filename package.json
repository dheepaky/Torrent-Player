{
  "name": "Torrent-player",
  "description": "Video streaming directly from your browser",
  "version": "2.1.0",
  "type": "module",
  "author": "",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.27.3",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"node server.js\" \"vite\"",
    "server": "node server.js",
    "start": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -b gh-pages"
