{
  "name": "Torrent-player",
  "description": "Video streaming directly from your browser",
  "version": "2.1.0",
  "type": "module",
  "main": "electron/main.js",
  "author": "",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.27.3",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"node server.js\" \"vite\"",
    "server": "node server.js",
    "start": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "npm run build && electron .",
    "electron:dev": "concurrently -k -n \"SERVER,CLIENT,APP\" -c \"cyan,magenta,yellow\" \"node server.js\" \"vite\" \"electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -b gh-pages"
  },
  "build": {
    "appId": "com.torrentplayer.app",
    "productName": "Torrent Player",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server.js",
      "package.json"
    ],
    "asarUnpack": [
      "server.js",
      "node_modules/webtorrent/**",
      "node_modules/@webtorrent/**",
      "node_modules/utp-native/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/favicon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/favicon.png",
      "category": "Video"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/favicon.png",
      "category": "public.app-category.video"
    }
  },
  "keywords": [
    "data channel",
    "file transfer",
    "p2p",
    "webrtc"
  ],
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "webtorrent": "^3.0.21"
  }
}
